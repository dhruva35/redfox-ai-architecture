# Copy this file to .env and fill in your values

# ── LLM Backend (pick one) ─────────────────────────────────────────────
# Option 1: Groq (FREE, fast — recommended) - llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: OpenAI (costs ~$0.01 per run)
# OPENAI_API_KEY=sk-your-key-here

# Priority: Groq > OpenAI > Scripted fallback (no key needed)

# ── Target URL ─────────────────────────────────────────────────────────
# Only use sites you have permission to test.
# testphp.vulnweb.com is Acunetix's deliberately vulnerable test site - public and safe to test.
# httpbin.org is a public HTTP testing service (always online).
DEMO_TARGET=http://httpbin.org

# ── Agent Settings ─────────────────────────────────────────────────────
# Maximum number of steps before the agent stops
DEMO_MAX_STEPS=8

# ── Web Dashboard ──────────────────────────────────────────────────────
# Port for the web dashboard server
DASHBOARD_PORT=5000
